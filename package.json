{
  "name": "mermaid-browser-live-editor",
  "publisher": "codewithgod",
  "displayName": "Mermaid Browser & Live Editor",
  "description": "Browse, search, live edit, and export Mermaid diagrams across your workspace with PDF math support.",
  "version": "0.3.6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dragonwinner/Mermaid-Browser-Live-Editor.git"
  },
  "homepage": "https://github.com/Dragonwinner/Mermaid-Browser-Live-Editor#readme",
  "bugs": {
    "url": "https://github.com/Dragonwinner/Mermaid-Browser-Live-Editor/issues"
  },
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#2e3039",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "mermaid",
    "diagram",
    "markdown",
    "flowchart",
    "pdf"
  ],
  "activationEvents": [
    "onCommand:mermaidBrowser.open",
    "onCommand:mermaidBrowser.createDiagram",
    "onCommand:mermaidBrowser.previewDiagram",
    "onCommand:mermaidBrowser.refresh",
    "onCommand:mermaidBrowser.exportMarkdownPdf",
    "onLanguage:mermaid",
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid",
          "mermaid"
        ],
        "extensions": [
          ".mmd",
          ".mermaid"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mermaid",
        "scopeName": "source.mermaid",
        "path": "./syntaxes/mermaid.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mermaidBrowser.open",
        "title": "Open Workspace Browser",
        "category": "Mermaid Browser",
        "icon": "$(search)"
      },
      {
        "command": "mermaidBrowser.previewDiagram",
        "title": "Preview Current Diagram",
        "category": "Mermaid Browser",
        "icon": "$(preview)"
      },
      {
        "command": "mermaidBrowser.createDiagram",
        "title": "Create Diagram",
        "category": "Mermaid Browser",
        "icon": "$(new-file)"
      },
      {
        "command": "mermaidBrowser.refresh",
        "title": "Refresh Workspace Index",
        "category": "Mermaid Browser",
        "icon": "$(refresh)"
      },
      {
        "command": "mermaidBrowser.exportMarkdownPdf",
        "title": "Export Markdown as PDF",
        "category": "Mermaid Browser",
        "icon": "$(file-pdf)"
      },
      {
        "command": "mermaidBrowser.previewInline",
        "title": "Preview This Diagram",
        "category": "Mermaid Browser",
        "icon": "$(preview)"
      },
      {
        "command": "mermaidBrowser.editLive",
        "title": "Edit Live",
        "category": "Mermaid Browser",
        "icon": "$(edit)"
      },
      {
        "command": "mermaidBrowser.copyInline",
        "title": "Copy Diagram Source",
        "category": "Mermaid Browser",
        "icon": "$(copy)"
      },
      {
        "command": "mermaidBrowser.exportSvgInline",
        "title": "Export Diagram as SVG",
        "category": "Mermaid Browser",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mermaidBrowser.previewDiagram",
          "when": "resourceExtname =~ /^\\.(mmd|mermaid)$/",
          "group": "navigation@1"
        },
        {
          "command": "mermaidBrowser.open",
          "when": "resourceExtname =~ /^\\.(md|markdown)$/",
          "group": "navigation@1"
        },
        {
          "command": "mermaidBrowser.exportMarkdownPdf",
          "when": "resourceExtname =~ /^\\.(md|markdown)$/",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "mermaidBrowser.open",
          "when": "resourceExtname =~ /^\\.(mmd|mermaid|md|markdown)$/",
          "group": "mermaid@1"
        },
        {
          "command": "mermaidBrowser.exportMarkdownPdf",
          "when": "resourceExtname =~ /^\\.(md|markdown)$/",
          "group": "mermaid@2"
        },
        {
          "command": "mermaidBrowser.editLive",
          "when": "resourceExtname =~ /^\\.(md|markdown)$/",
          "group": "mermaid@3"
        }
      ],
      "explorer/context": [
        {
          "command": "mermaidBrowser.exportMarkdownPdf",
          "when": "resourceExtname =~ /^\\.(md|markdown)$/",
          "group": "mermaid@1"
        },
        {
          "command": "mermaidBrowser.open",
          "when": "resourceExtname =~ /^\\.(mmd|mermaid|md|markdown)$/",
          "group": "mermaid@2"
        }
      ]
    },
    "configuration": {
      "title": "Mermaid Browser",
      "properties": {
        "mermaidBrowser.fileLimit": {
          "type": "number",
          "default": 2500,
          "minimum": 100,
          "maximum": 10000,
          "description": "Maximum number of workspace files indexed by Mermaid Browser."
        },
        "mermaidBrowser.includeMarkdown": {
          "type": "boolean",
          "default": true,
          "description": "Index Mermaid code fences in Markdown files."
        },
        "mermaidBrowser.previewTheme": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "neutral",
            "dark",
            "forest",
            "base"
          ],
          "description": "Mermaid theme used in workspace browser previews."
        }
      }
    },
    "markdown.previewScripts": [
      "./dist/markdownPreviewMermaid.js"
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node scripts/copyThirdPartyLicenses.mjs && tsc -p . --noEmit && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 && esbuild src/mermaidRuntime.ts --bundle --outfile=dist/mermaidRuntime.js --format=esm --platform=browser --target=es2022 --loader:.css=text --minify && esbuild src/markdownPreviewMermaid.ts --bundle --outfile=dist/markdownPreviewMermaid.js --format=iife --platform=browser --target=es2022 --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --watch",
    "check": "tsc -p . --noEmit",
    "package": "vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "dompurify": "3.4.13",
    "esbuild": "^0.25.0",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "katex": "0.18.4",
    "marked": "16.4.2",
    "mermaid": "11.16.1",
    "typescript": "^7.0.2"
  }
}
