{
  "name": "mermaid-browser",
  "publisher": "studywithgod",
  "displayName": "Mermaid Browser",
  "description": "Browse, search, preview, create, and export Mermaid diagrams across a VS Code workspace.",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Visualization", "Other"],
  "keywords": ["mermaid", "diagram", "browser", "flowchart", "sequence diagram", "workspace"],
  "activationEvents": [
    "onCommand:mermaidBrowser.open",
    "onCommand:mermaidBrowser.createDiagram",
    "onCommand:mermaidBrowser.previewDiagram"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mermaid",
        "aliases": ["Mermaid", "mermaid"],
        "extensions": [".mmd", ".mermaid"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/mermaid-browser-file.svg",
          "dark": "./assets/mermaid-browser-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "mermaid",
        "scopeName": "source.mermaid",
        "path": "./syntaxes/mermaid.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mermaidBrowser.open",
        "title": "Mermaid Browser: Open Workspace Browser",
        "icon": "$(search)"
      },
      {
        "command": "mermaidBrowser.previewDiagram",
        "title": "Mermaid Browser: Preview Current Diagram",
        "icon": "$(preview)"
      },
      {
        "command": "mermaidBrowser.createDiagram",
        "title": "Mermaid Browser: Create Diagram",
        "icon": "$(new-file)"
      },
      {
        "command": "mermaidBrowser.refresh",
        "title": "Mermaid Browser: Refresh Workspace Index",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mermaidBrowser.previewDiagram",
          "when": "resourceExtname =~ /^\\.(mmd|mermaid)$/",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "mermaidBrowser.open",
          "when": "resourceExtname =~ /^\\.(mmd|mermaid|md|markdown)$/",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Mermaid Browser",
      "properties": {
        "mermaidBrowser.fileLimit": {
          "type": "number",
          "default": 2500,
          "minimum": 100,
          "maximum": 10000,
          "description": "Maximum number of workspace files indexed by Mermaid Browser."
        },
        "mermaidBrowser.includeMarkdown": {
          "type": "boolean",
          "default": true,
          "description": "Index Mermaid code fences in Markdown files."
        },
        "mermaidBrowser.previewTheme": {
          "type": "string",
          "default": "default",
          "enum": ["default", "neutral", "dark", "forest", "base"],
          "description": "Mermaid theme used in workspace browser previews."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p . --noEmit && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 && esbuild src/mermaidRuntime.ts --bundle --outfile=dist/mermaidRuntime.js --format=esm --platform=browser --target=es2022 --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --watch",
    "check": "tsc -p . --noEmit",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "mermaid": "11.16.1",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.15.1"
}
