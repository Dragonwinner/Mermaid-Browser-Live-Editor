{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": [
    "src/extension.ts",
    "src/liveEditPanel.ts",
    "src/markdownPdfPanel.ts",
    "src/markdownPreviewMermaid.ts",
    "src/mermaidBrowserPanel.ts",
    "src/mermaidCodeLens.ts",
    "src/mermaidRuntime.ts"
  ]
}
